<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <PackageId>Metalama.Community.Costura</PackageId>
    <PackageDescription>A Metalama weaver that embeds dependent assemblies as managed resources. A fork of Costura.Fody.</PackageDescription>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Metalama.Framework" />
    <PackageReference Include="Metalama.Framework.Sdk" PrivateAssets="all" />
    <ProjectReference Include="..\Metalama.Community.Costura\Metalama.Community.Costura.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The files under Resources\ are runtime templates injected into the user's compilation. They are not
         compiled here: they are embedded verbatim into the generated Resources.cs as raw string literals. -->
    <Compile Remove="Resources\*.cs" />
    <None Include="Resources\*.cs" />
    <CosturaTemplate Include="Resources\*.cs" />

    <!-- Resources.cs is generated below and added to @(Compile) by the target itself, so that a build succeeds
         even when the file does not exist yet (the default glob is evaluated before the target runs). -->
    <Compile Remove="Resources.cs" />
  </ItemGroup>

  <!--
    Generates Resources.cs from the files under Resources\.

    This used to be a T4 template (Resources.tt) driven by TextTemplatingFileGenerator, which only Visual Studio
    runs. Editing a template therefore had no effect on `dotnet build`, and the stale generated file was used
    instead - that is how the corrupt `private init;.` text in TemplateWithUnmanagedHandler survived (#100, #101).
    Generating from MSBuild keeps the generated file in sync on every build, on every machine.
  -->
  <UsingTask TaskName="GenerateCosturaResources" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Templates ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <OutputPath ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
var paths = new System.Collections.Generic.List<string>();

foreach ( var template in Templates )
{
    paths.Add( template.GetMetadata( "FullPath" ) );
}

// Sort so that the generated file is deterministic regardless of file-system enumeration order.
paths.Sort( System.StringComparer.Ordinal );

var builder = new System.Text.StringBuilder();
builder.Append( "// <autogenerated />\n" );
builder.Append( "// Generated from Resources\\*.cs by the GenerateCosturaResourcesFile target. Do not edit.\n\n" );
builder.Append( "using Metalama.Framework.Aspects;\n\n" );
builder.Append( "namespace Metalama.Community.Costura.Weaver;\n\n" );
builder.Append( "[CompileTime]\n" );
builder.Append( "internal static class Resources\n" );
builder.Append( "{\n" );

foreach ( var path in paths )
{
    var content = System.IO.File.ReadAllText( path );

    // Conservative: a template containing the delimiter anywhere is rejected rather than embedded with a longer
    // one. No template needs it, and getting this wrong would produce a generated file that does not parse.
    if ( content.Contains( "\"\"\"" ) )
    {
        Log.LogError(
            "The template '" + path + "' contains the raw string delimiter \"\"\" and cannot be embedded." );

        return false;
    }

    if ( !content.EndsWith( "\n" ) )
    {
        content += "\n";
    }

    builder.Append( "    internal const string " ).Append( System.IO.Path.GetFileNameWithoutExtension( path ) ).Append( " = \"\"\"\n" );
    builder.Append( content );
    builder.Append( "\"\"\";\n\n" );
}

builder.Append( "}\n" );

var text = builder.ToString();

// Write only when the content actually changed, so that we do not trigger a needless rebuild.
if ( !System.IO.File.Exists( OutputPath ) || System.IO.File.ReadAllText( OutputPath ) != text )
{
    System.IO.File.WriteAllText( OutputPath, text, new System.Text.UTF8Encoding( false ) );
}
]]></Code>
    </Task>
  </UsingTask>

  <Target Name="GenerateCosturaResourcesFile"
          BeforeTargets="BeforeCompile"
          Inputs="@(CosturaTemplate);$(MSBuildProjectFullPath)"
          Outputs="$(MSBuildProjectDirectory)\Resources.cs">
    <GenerateCosturaResources Templates="@(CosturaTemplate)" OutputPath="$(MSBuildProjectDirectory)\Resources.cs" />
  </Target>

  <Target Name="IncludeCosturaResourcesFile" BeforeTargets="BeforeCompile" DependsOnTargets="GenerateCosturaResourcesFile">
    <ItemGroup>
      <Compile Include="$(MSBuildProjectDirectory)\Resources.cs" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="Metalama.Community.Costura.Tests" />
  </ItemGroup>

  <!-- Packaging -->
  <ItemGroup>
      <None Include="..\README.md" Pack="true" PackagePath="" />
      <None Include="..\LICENSE.md" Visible="false" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
