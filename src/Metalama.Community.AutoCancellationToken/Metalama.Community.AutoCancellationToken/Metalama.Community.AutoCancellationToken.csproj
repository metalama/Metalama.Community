<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
      <PackageTags>$(PackageTags) PostSharp Metalama AOP</PackageTags>
      <PackageDescription>A Metalama weaver that automatically adds CancellationToken to your method definitions and your method calls.</PackageDescription>
      <PackageReadmeFile>README.md</PackageReadmeFile>
      <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Metalama.Framework" />
    <PackageReference Include="Metalama.Framework.Sdk" PrivateAssets="all" />
  </ItemGroup>

  <!-- Roslyn types that the weaver stores in static fields. They are immutable, but Roslyn does not mark them
       with [ImmutableType], so the Metalama immutability analyzer must be told (LAMA0890). -->
  <ItemGroup>
    <MetalamaImmutableType Include="Microsoft.CodeAnalysis.DiagnosticDescriptor" />
    <MetalamaImmutableType Include="Microsoft.CodeAnalysis.CSharp.Syntax.TypeSyntax" />
  </ItemGroup>

  <!-- Packaging -->
  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="" />
    <None Include="..\LICENSE.md" Visible="false" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
